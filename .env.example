APP_ENV=development
LOG_LEVEL=INFO
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
REQUEST_TIMEOUT_SECONDS=20
DEFAULT_MARKET_LIMIT=50
MIN_LIQUIDITY=1000
MIN_VOLUME=1000

DATABASE_URL=sqlite+aiosqlite:///./polymarket.db

# Worker
WORKER_INTERVAL_SECONDS=900
WORKER_MAX_RESEARCH_PER_CYCLE=3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_OUTPUT_TOKENS=2500
