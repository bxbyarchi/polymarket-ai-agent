APP_ENV=development
LOG_LEVEL=INFO
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
REQUEST_TIMEOUT_SECONDS=20
DEFAULT_MARKET_LIMIT=50
MIN_LIQUIDITY=1000
MIN_VOLUME=1000

# Local default uses SQLite. For Render Postgres use the DATABASE_URL provided by Render.
DATABASE_URL=sqlite+aiosqlite:///./polymarket.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_OUTPUT_TOKENS=2500
