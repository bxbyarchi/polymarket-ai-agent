APP_ENV=development
LOG_LEVEL=INFO
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
REQUEST_TIMEOUT_SECONDS=20
DEFAULT_MARKET_LIMIT=100
MIN_LIQUIDITY=1000
MIN_VOLUME=1000

DATABASE_URL=sqlite+aiosqlite:///./polymarket.db

# Worker
WORKER_INTERVAL_SECONDS=900
WORKER_MAX_RESEARCH_PER_CYCLE=5
MIN_RESEARCH_INTERVAL_SECONDS=3600
RESOLUTION_CONCURRENCY=10
RESEARCH_HORIZON_HOURS=48
RESEARCH_CATEGORIES=politics,finance,sports

GEMINI_API_KEY=
ADMIN_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLE_GOOGLE_SEARCH=false
AI_MAX_OUTPUT_TOKENS=2500


# Optional Polymarket CLOB credentials (keep real values out of Git)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_ADDRESS=
